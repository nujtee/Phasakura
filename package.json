{
  "name": "phasakura",
  "private": true,
  "version": "0.1.0",
  "description": "Accommodation booking website and back-office on Cloudflare Workers, D1 and R2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run preflight && npm run build && wrangler deploy",
    "release": "npm run preflight && npm run db:backup && npm run db:migrate:remote && npm run build && wrangler deploy",
    "preflight": "tsx scripts/preflight.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "test": "tsx --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "check:static": "tsx scripts/static-checks.ts",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run check:static && npm test",
    "cf-typegen": "wrangler types",
    "admin:bootstrap": "tsx scripts/create-super-admin.ts",
    "db:migrate:local": "wrangler d1 migrations apply phasakura-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply phasakura-db --remote",
    "db:migrations:list": "wrangler d1 migrations list phasakura-db --local",
    "db:migrations:list:remote": "wrangler d1 migrations list phasakura-db --remote",
    "db:backup": "tsx scripts/backup-d1.ts",
    "db:seed:local": "wrangler d1 execute phasakura-db --local --file seeds/dev.sql",
    "db:reset:local": "node -e \"require('fs').rmSync('.wrangler/state/v3/d1',{recursive:true,force:true})\" && npm run db:migrate:local && npm run db:seed:local"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "wrangler": "^4.20.0"
  }
}
