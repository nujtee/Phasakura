// GENERATED by `npm run sites:generate` from sites/sites.json ("center" + every site) and wrangler.jsonc — do not edit.
// Center Management console: its own Worker and D1; each site is reached through its service binding (no public internet,
// no bot protection in the way). Secret: CENTER_SIGNING_KEY (Actions → Center keys). Never any site's secrets.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "center",
  "main": "../src/center/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "center.phasakura.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_BASE_URL": "https://center.phasakura.com",
    "CENTER_SITES": "[{\"slug\":\"phasakura\",\"name\":\"Phasakura\",\"domain\":\"phasakura.com\",\"binding\":\"SITE_PHASAKURA\"},{\"slug\":\"chomkhao\",\"name\":\"Chomkhao\",\"domain\":\"chomkhao.com\",\"binding\":\"SITE_CHOMKHAO\"},{\"slug\":\"cherngdoi\",\"name\":\"Cherngdoi\",\"domain\":\"cherngdoi.com\",\"binding\":\"SITE_CHERNGDOI\"}]"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "center-db",
      "database_id": "0a640198-a742-43ac-b1d9-96facf21731e",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "SITE_PHASAKURA",
      "service": "phasakura"
    },
    {
      "binding": "SITE_CHOMKHAO",
      "service": "chomkhao"
    },
    {
      "binding": "SITE_CHERNGDOI",
      "service": "cherngdoi"
    }
  ]
}
