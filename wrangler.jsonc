// Cloudflare Worker configuration.
// - No secrets in this file. Secrets go to `wrangler secret put <NAME>` (production)
//   or `.dev.vars` (local, gitignored). See `.dev.vars.example`.
// - D1 database_id is not a secret (phasakura-db, location hint APAC, created 2026-10-07).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phasakura",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  // Workers Logs (Phase 16): every request and every console.error is kept (3 days Free / 7 days Paid).
  // The owner-facing error log and cron heartbeat are in D1 (Admin → System status).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Production domain (Phase 16): phasakura.com (Cloudflare Registrar, zone on Cloudflare).
  // Custom Domains create the DNS records and TLS certificates automatically. APP_BASE_URL is the apex;
  // www.phasakura.com reaches the same Worker and is redirected (301) to it (src/worker/http/canonical-host.ts).
  "routes": [
    { "pattern": "phasakura.com", "custom_domain": true },
    { "pattern": "www.phasakura.com", "custom_domain": true }
  ],
  // Keep *.workers.dev off in production (duplicate site, skips the zone's security settings).
  "workers_dev": false,
  // Version preview URLs would run unreleased code against the production D1 / R2 — keep them off.
  "preview_urls": false,

  // Single Worker serves the API and the React SPA (ADR-1).
  // Every request except the hashed build files under /assets/ runs the Worker first (Phase 13): it renders
  // the app shell with page metadata and the right status code (404 for unknown pages), serves robots.txt /
  // sitemap.xml, applies SEO redirects and serves /media/* (public R2 images) and /api/*.
  // /assets/* comes straight from static assets (immutable, long cache); a missing build file is a real 404
  // (no app-shell fallback: page routing lives in the Worker).
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  },

  // Every minute: expire unpaid booking holds (release inventory), plan + send LINE notifications
  // (retries with backoff), Meta CAPI delivery, then a heartbeat row (GET /api/health → cron "stale" after
  // 5 minutes without one). Camping drift check every 15 minutes. Needs the Workers Paid plan (CPU time).
  "triggers": {
    "crons": ["* * * * *"]
  },

  // Non-secret configuration. `.dev.vars` overrides these locally.
  "vars": {
    "APP_ENV": "production",
    // Canonical https origin: canonical / hreflang / sitemap URLs, password reset / invite links, LINE messages.
    "APP_BASE_URL": "https://phasakura.com",
    "PUBLIC_MEDIA_BASE_URL": "",
    // Slip verification service ("easyslip" or empty = staff verify every slip).
    // The API key is a secret: `wrangler secret put SLIP_VERIFICATION_API_KEY` — never here.
    "SLIP_VERIFY_PROVIDER": "",
    // Graph API version for the Meta Conversions API (update when Meta retires it).
    "META_GRAPH_API_VERSION": "v23.0"
    // LINE: `wrangler secret put LINE_CHANNEL_ACCESS_TOKEN` and `wrangler secret put LINE_CHANNEL_SECRET` — never here.
    // Meta: `wrangler secret put META_CAPI_ACCESS_TOKEN` (+ optional META_PIXEL_ID, META_TEST_EVENT_CODE) — never here.
    // GA4 dashboard numbers: `wrangler secret put GA4_SERVICE_ACCOUNT_KEY` — never here.
  },

  // D1 — source of truth for bookings, payments, revenue, inventory, food capacity.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phasakura-db",
      "database_id": "8f013af9-6464-4ed2-8aa1-f426fbb707b8",
      "migrations_dir": "migrations"
    }
  ],

  // R2 — two buckets with separate access policies (ADR-5).
  // MEDIA_PUBLIC : logos, favicon, slides, gallery, history, accommodation & food images.
  // MEDIA_PRIVATE: payment slips and any private file. Never exposed publicly.
  "r2_buckets": [
    {
      "binding": "MEDIA_PUBLIC",
      "bucket_name": "phasakura-media-public"
    },
    {
      "binding": "MEDIA_PRIVATE",
      "bucket_name": "phasakura-media-private"
    }
  ],

  // Per-IP request limits (Phase 14, spec §58) — Workers Rate Limiting, counted at the edge (no D1 writes).
  // namespace_id must be unique per account; period is 10 or 60 seconds.
  "ratelimits": [
    { "name": "RL_PUBLIC", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_ADMIN", "namespace_id": "1004", "simple": { "limit": 600, "period": 60 } }
  ]
}
