{
  // Editor / tsx config covering the whole repo. `npm run typecheck` uses the
  // stricter per-target configs (worker, app, test, node).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["src", "tests", "vite.config.ts"]
}
