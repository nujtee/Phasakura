# Copy to `.dev.vars` for local development (`.dev.vars` is gitignored).
# NEVER commit real values. Production values are set with `wrangler secret put <NAME>`.

APP_ENV=development

# Origin used in password reset / invite links (defaults to the request origin)
APP_BASE_URL=http://localhost:5173

# Optional: public URL of the R2 public bucket (custom domain), e.g. https://media.example.com
# Leave empty to serve public media through the Worker at /media/* (Phase 12).
PUBLIC_MEDIA_BASE_URL=

# --- Meta Pixel + Conversions API (Phase 14) ---
# Pixel ID can also be entered in Admin → Marketing; a value here wins (and the page warns on mismatch).
# The access token is a SECRET: Events Manager → your dataset → Settings → Conversions API → Generate access token.
# The test event code (Events Manager → Test events) routes EVERY server event to Test events while set —
# remove it in production. Production: `wrangler secret put META_CAPI_ACCESS_TOKEN` (never in wrangler.jsonc / Git / D1).
# META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
# META_TEST_EVENT_CODE=
# META_GRAPH_API_VERSION=v23.0

# --- GA4 Data API (Phase 14): dashboard visitors / page views / booking steps ---
# JSON key of a Google Cloud service account that has Viewer access to the GA4 property (one line).
# The property ID itself is entered in Admin → Marketing → GA4. Production: `wrangler secret put GA4_SERVICE_ACCOUNT_KEY`.
# GA4_SERVICE_ACCOUNT_KEY={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# Slip verification (Phase 8): provider name is plain config; the key is a secret.
# SLIP_VERIFY_PROVIDER=easyslip
# SLIP_VERIFICATION_API_KEY=

# LINE Messaging API (Phase 11) — LINE Developers console → your Messaging API channel.
# Long-lived channel access token (Messaging API tab) and channel secret (Basic settings tab).
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=

# E-mail notifications (migration 0023) — from the Zoho Mail mailbox: Zoho API Console (api-console.zoho.com) →
# Self Client → client id / secret; Generate Code with the scopes ZohoMail.messages.CREATE,ZohoMail.accounts.READ,
# then exchange the code for a refresh token (docs/PRODUCTION.md). ZOHO_REGION only when not US (eu, in, com.au, jp, ca, sa).
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_REGION=
# …or Resend instead (used only while the Zoho secrets are not set); the sender domain must be verified there.
# RESEND_API_KEY=

# PayPal Checkout (migration 0023) — PayPal Developer → Apps & Credentials → REST app (client id + secret).
# PAYPAL_ENV=sandbox   (unset = live PayPal)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
